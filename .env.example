# ─── LLM ──────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-CHANGEME        # Shadow Agent (Claude claude-sonnet-4-6)
OPENAI_API_KEY=sk-CHANGEME               # Sub-agents (GPT-4o) + embeddings (text-embedding-3-large)

# ─── Kafka ────────────────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=kafka:9092       # Use localhost:29092 when connecting from host machine
KAFKA_SCHEMA_REGISTRY_URL=http://schema-registry:8081

# ─── Databases ────────────────────────────────────────────────────────────────
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_API_KEY=                          # Leave empty for local dev (no auth)

NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=orchid_neo4j_pass         # Change before any shared deployment

# ─── Airflow ──────────────────────────────────────────────────────────────────
# Generate Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW__CORE__FERNET_KEY=CHANGEME_generate_with_command_above
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://airflow:airflow@postgres/airflow
AIRFLOW__WEBSERVER__SECRET_KEY=CHANGEME_32_char_random_string

# ─── API ──────────────────────────────────────────────────────────────────────
API_SECRET_KEY=CHANGEME_jwt_signing_secret
TENANT_DB_URL=postgresql+psycopg2://orchid:CHANGEME@postgres/orchid_tenants

# ─── Sandbox ──────────────────────────────────────────────────────────────────
SANDBOX_IMAGE=orchid-sandbox:latest
SANDBOX_MAX_DURATION_SEC=3600            # 60-minute sessions
SANDBOX_PASSWORD=orchid_candidate_2024   # code-server web password

# ─── Feature Flags ────────────────────────────────────────────────────────────
ENABLE_EYE_TRACKING=false
ENABLE_CHAOS_INJECTION=true

# ─── Observability ────────────────────────────────────────────────────────────
LOG_LEVEL=INFO                           # Set to DEBUG during active development
