{
  "namespace": "io.orchid.telemetry",
  "type": "record",
  "name": "PromptSentEvent",
  "doc": "A candidate sends an instruction to a sub-agent (DELTA, NOVA, or ECHO).",
  "fields": [
    {"name": "event_id",   "type": "string", "doc": "UUID v4"},
    {"name": "session_id", "type": "string", "doc": "Ties all events to one candidate session"},
    {"name": "timestamp",  "type": "string", "doc": "ISO 8601 UTC"},
    {"name": "event_type", "type": "string", "default": "PROMPT_SENT"},
    {"name": "agent",      "type": "string", "doc": "DELTA | NOVA | ECHO"},
    {"name": "text",       "type": "string", "doc": "The candidate's instruction text"},
    {
      "name": "context_json",
      "type": "string",
      "default": "{}",
      "doc": "JSON-encoded context dict (files open, prior commands, etc.)"
    }
  ]
}
