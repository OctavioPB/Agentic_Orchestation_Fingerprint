{
  "namespace": "io.orchid.telemetry",
  "type": "record",
  "name": "CorrectionIssuedEvent",
  "doc": "The candidate explicitly corrects or overrides a sub-agent output.",
  "fields": [
    {"name": "event_id",          "type": "string", "doc": "UUID v4"},
    {"name": "session_id",        "type": "string"},
    {"name": "timestamp",         "type": "string", "doc": "ISO 8601 UTC"},
    {"name": "event_type",        "type": "string", "default": "CORRECTION_ISSUED"},
    {"name": "agent",             "type": "string", "doc": "Agent being corrected"},
    {"name": "correction_text",   "type": "string", "doc": "The candidate's correction instruction"},
    {"name": "original_event_id", "type": "string", "doc": "event_id of the AGENT_RESPONSE being corrected"},
    {
      "name": "error_type",
      "type": ["null", "string"],
      "default": null,
      "doc": "Categorised error type: hallucinated_column_name | scope_overreach | factual_error | etc."
    }
  ]
}
